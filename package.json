{
  "name": "adometa-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --pretty false",
    "test": "node --test",
    "mysql:migrate": "node --env-file=.env mysql/scripts/migrate.mjs",
    "mysql:worker": "node --env-file=.env mysql/sync/worker.mjs",
    "mysql:backfill": "node --env-file=.env mysql/scripts/backfill.mjs",
    "mysql:reconcile": "node --env-file=.env mysql/scripts/reconcile.mjs",
    "mysql:api": "node --env-file=.env mysql/services/server.mjs",
    "mysql:test": "node --env-file=.env --test mysql/tests",
    "seo:publish": "node scripts/publish-static-seo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@vitejs/plugin-react": "^4.3.4",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.14.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.6"
  }
}
