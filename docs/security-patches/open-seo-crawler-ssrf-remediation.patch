@@ -0,0 +1,69 @@
+import ipaddress
+
+import pytest
+
+import app as crawler
+
+
+def test_private_and_reserved_addresses_are_rejected():
+    for address in ("127.0.0.1", "10.0.0.1", "169.254.169.254", "::1", "fd00::1"):
+        with pytest.raises(ValueError):
+            crawler._public_ip(address)
+
+
+def test_public_address_is_accepted():
+    assert crawler._public_ip("8.8.8.8") == ipaddress.ip_address("8.8.8.8")
+
+
+def test_redirect_target_is_resolved_and_rejected_before_connection(monkeypatch):
+    connected_hosts = []
+
+    class RedirectResponse:
+        status = 302
+
+        def getheader(self, name):
+            return "http://127.0.0.1/admin" if name.lower() == "location" else None
+
+        def read(self, size):
+            return b""
+
+    class FakeConnection:
+        def __init__(self, hostname, port, address, timeout):
+            connected_hosts.append(hostname)
+
+        def request(self, *args, **kwargs):
+            pass
+
+        def getresponse(self):
+            return RedirectResponse()
+
+        def close(self):
+            pass
+
+    monkeypatch.setattr(crawler, "_PinnedHTTPConnection", FakeConnection)
+    monkeypatch.setattr(crawler, "_resolve_public_ip", lambda host, port: "93.184.216.34" if host == "public.example" else crawler._public_ip(host))
+
+    with pytest.raises(ValueError, match="private or reserved"):
+        crawler._fetch_public_text("http://public.example/robots.txt")
+    assert connected_hosts == ["public.example"]
+
+
+def test_private_ip_literal_is_rejected_without_dns(monkeypatch):
+    monkeypatch.setattr(crawler.socket, "getaddrinfo", lambda *args, **kwargs: pytest.fail("literal IP must not be resolved"))
+    with pytest.raises(ValueError, match="private or reserved"):
+        crawler._resolve_public_ip("127.0.0.1", 80)
+
+
+def test_connected_peer_must_match_pinned_address():
+    class FakeSocket:
+        def getpeername(self):
+            return ("1.1.1.1", 80)
+
+    with pytest.raises(OSError, match="peer did not match"):
+        crawler._verify_peer(FakeSocket(), "8.8.8.8")
+
+
+def test_robots_endpoint_rejects_private_targets():
+    response = crawler.app.test_client().get("/fetch-robots-txt?url=http://127.0.0.1/admin")
+    assert response.status_code == 502
+    assert "private or reserved" in response.get_json()["error"]
